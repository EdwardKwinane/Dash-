# Medusa v2 Backend — Environment Template (placeholders only, never commit real values)
# Source of truth for local development: `apps/backend/.env`

# --- Database ---
DATABASE_URL=postgres://USER@localhost:5432/DB_NAME
DB_NAME=medusa-dash-backend

# --- Store / Admin / Auth CORS ---
# Storefront is at localhost:3000 (Next.js). Admin at localhost:9000/app.
STORE_CORS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_CORS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:9000
AUTH_CORS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:9000

# --- Secrets (rotate for any deployment) ---
JWT_SECRET=replace-me-32-char-string
COOKIE_SECRET=replace-me-32-char-string
AUTH_MFA_ENCRYPTION_KEY=replace-me

# --- Redis (optional — events / notification queue) ---
REDIS_URL=redis://localhost:6379

# --- South Africa market (documented; not hardcoded in this file) ---
# Default currency: ZAR; region: South Africa (ZA)
# Configure in Medusa Admin → Settings → Regions after DB migrations.
